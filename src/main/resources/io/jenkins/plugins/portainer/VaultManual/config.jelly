<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="${%Vault URL}" field="vaultUrl">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Vault AppRole credentials}" field="vaultAppRoleCredentialsId">
    <c:select/>
  </f:entry>
  <st:include page="common.jelly" class="${descriptor.kvViewClass}"/>
</j:jelly>
